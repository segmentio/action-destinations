  "presets": [
    {
      "name": "Send Web Event",
      "type": "automatic",
      "partnerAction": "sendEvent",
      "subscribe": "type = \"track\" or type = \"page\"",
      "mapping": {
        "event": {
          "@if": {
            "exists": {
              "@path": "$.event"
            },
            "then": {
              "@path": "$.event"
            },
            "else": {
              "@path": "$.type"
            }
          }
        },
        "timestamp": {
          "@path": "$.timestamp"
        },
        "session_id": {
          "@path": "$.anonymousId"
        },
        "user_id": {
          "@path": "$.userId"
        },
        "distinct_id": {
          "@path": "$.messageId"
        },
        "ip_address": {
          "@path": "$.context.ip"
        },
        "user_agent": {
          "@path": "$.context.userAgent"
        },
        "url": {
          "@if": {
            "exists": {
              "@path": "$.context.page.url"
            },
            "then": {
              "@path": "$.context.page.url"
            },
            "else": {
              "@path": "$.properties.url"
            }
          }
        },
        "referrer_url": {
          "@if": {
            "exists": {
              "@path": "$.context.page.referrer"
            },
            "then": {
              "@path": "$.context.page.referrer"
            },
            "else": {
              "@path": "$.properties.referrer"
            }
          }
        },
        "email": {
          "@if": {
            "exists": {
              "@path": "$.context.traits.email"
            },
            "then": {
              "@path": "$.context.traits.email"
            },
            "else": {
              "@path": "$.properties.email"
            }
          }
        },
        "order_id": {
          "@path": "$.properties.order_id"
        },
        "order_total": {
          "@if": {
            "exists": {
              "@path": "$.properties.total"
            },
            "then": {
              "@path": "$.properties.total"
            },
            "else": {
              "@path": "$.properties.revenue"
            }
          }
        },
        "args": {
          "@path": "$.properties"
        },
        "enable_batching": true,
        "batch_size": 1000
      },
      "eventSlug": null
    }
