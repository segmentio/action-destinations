    {
      "name": "Send Event",
      "type": "automatic",
      "partnerAction": "sendEvent",
      "subscribe": "type = \"track\" or type = \"page\" or type = \"screen\"",
      "mapping": {
        "schemaRefContentType": "application/vnd.adobe.xed-full+json;version=1",
        "eventId": {
          "@path": "$.messageId"
        },
        "timestamp": {
          "@path": "$.timestamp"
        },
        "ecid": {
          "@path": "$.anonymousId"
        },
        "pid": {
          "@path": "$.userId"
        },
        "xdmMapping": {
          "web.webPageDetails.URL": {
            "@path": "$.context.page.url"
          },
          "web.webReferrer.URL": {
            "@path": "$.context.page.referrer"
          }
        },
        "enable_batching": true,
        "batch_size": 100,
        "batch_bytes": 800000,
        "batch_keys": [
          "imsOrgId",
          "sandboxName",
          "inletId"
        ]
      },
      "eventSlug": null
    },
